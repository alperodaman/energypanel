PORT=4000

# auth-service, facility-service ve telemetry-service ile AYNI JWT_SECRET değeri kullanılmalı,
# aksi halde Gateway'in erken token doğrulaması başarısız olur.
JWT_SECRET=change-me-to-a-long-random-string

AUTH_SERVICE_URL="http://localhost:4001"
FACILITY_SERVICE_URL="http://localhost:4002"
TELEMETRY_SERVICE_URL="http://localhost:3003"
