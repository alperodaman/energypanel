PORT=3003

# postgres-telemetry container'ına localhost'a map'li port üzerinden bağlanır (bkz. root .env.example, POSTGRES_TELEMETRY_PORT)
DATABASE_URL="postgresql://enerjipanel:change-me@localhost:5435/telemetry_db?schema=public"

JWT_SECRET=change-me-to-a-long-random-string

# rabbitmq container'ına localhost'a map'li port üzerinden bağlanır (bkz. root .env.example, RABBITMQ_PORT)
RABBITMQ_URL="amqp://enerjipanel:change-me@localhost:5672"

# Cron simülatörünün her cihaz için yeni bir Reading üretme sıklığı (ms)
TELEMETRY_INTERVAL_MS=10000

# Facility Service'in internal endpoint'lerine erişmek için (bkz. reconciliation job).
# Facility Service hangi portta çalışıyorsa o port kullanılmalı (bkz. facility-service/.env.example, PORT).
FACILITY_SERVICE_URL=http://localhost:4002

# Facility Service'in GET /internal/facilities ucunu korumak için kullandığı secret ile
# AYNI olmalı (bkz. facility-service/.env.example, INTERNAL_SERVICE_SECRET).
INTERNAL_SERVICE_SECRET=change-me-to-a-shared-internal-secret

# Reconciliation job'ın Facility Service ile local read model'i (FacilityOwnership,
# TrackedDevice) senkronize etme sıklığı (ms). Demo/geliştirme için kısa tutulabilir.
RECONCILIATION_INTERVAL_MS=300000
