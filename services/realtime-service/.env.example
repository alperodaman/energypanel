PORT=3005

# auth-service ile AYNI JWT_SECRET değeri kullanılmalı, aksi halde token doğrulaması başarısız olur.
JWT_SECRET=change-me-to-a-long-random-string

# rabbitmq container'ına localhost'a map'li port üzerinden bağlanır (bkz. root .env.example, RABBITMQ_PORT)
RABBITMQ_URL="amqp://enerjipanel:change-me@localhost:5672"

# redis container'ına localhost'a map'li port üzerinden bağlanır (bkz. root .env.example, REDIS_PORT/REDIS_PASSWORD)
REDIS_URL="redis://:change-me@localhost:6379"
