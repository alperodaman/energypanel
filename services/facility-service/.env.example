PORT=4002

# postgres-facility container'ına localhost'a map'li port üzerinden bağlanır (bkz. root .env.example, POSTGRES_FACILITY_PORT)
DATABASE_URL="postgresql://enerjipanel:change-me@localhost:5434/facility_db?schema=public"

JWT_SECRET=change-me-to-a-long-random-string

# servisler-arası internal endpoint'leri (bkz. /internal/facilities) korumak için kullanılır.
# Bu değer Telemetry Service'in .env'indeki INTERNAL_SERVICE_SECRET ile AYNI olmalı.
INTERNAL_SERVICE_SECRET=change-me-to-a-shared-internal-secret

# rabbitmq container'ına localhost'a map'li port üzerinden bağlanır (bkz. root .env.example, RABBITMQ_PORT)
RABBITMQ_URL="amqp://enerjipanel:change-me@localhost:5672"
