# Postgres - auth_db
POSTGRES_AUTH_USER=enerjipanel
POSTGRES_AUTH_PASSWORD=change-me
POSTGRES_AUTH_DB=auth_db

# Postgres - facility_db
POSTGRES_FACILITY_USER=enerjipanel
POSTGRES_FACILITY_PASSWORD=change-me
POSTGRES_FACILITY_DB=facility_db

# Postgres - telemetry_db
POSTGRES_TELEMETRY_USER=enerjipanel
POSTGRES_TELEMETRY_PASSWORD=change-me
POSTGRES_TELEMETRY_DB=telemetry_db

# RabbitMQ (AMQP port 5672 is internal-only — only the management UI is exposed to the host)
RABBITMQ_USER=enerjipanel
RABBITMQ_PASSWORD=change-me
RABBITMQ_MANAGEMENT_PORT=15672

# Redis (6379 is internal-only, not exposed to the host)
REDIS_PASSWORD=change-me

# JWT — shared by all 5 backend services (gateway, auth, facility, telemetry, realtime).
# Defined once here and injected into each service's environment in docker-compose.yml.
JWT_SECRET=change-me-to-a-long-random-string

# Service-to-service auth secret for internal endpoints (e.g. GET /internal/facilities),
# shared by facility-service, telemetry-service and realtime-service.
INTERNAL_SERVICE_SECRET=change-me-to-a-shared-internal-secret

# Frontend build-time env (baked into the JS bundle by Vite — must be reachable from the
# browser, so these stay as host-facing URLs, not Docker service names). Both now go
# through nginx-proxy (the reverse-proxy that fronts everything, mimari dokümanı §6.3)
# instead of hitting gateway/realtime-service ports directly.
VITE_GATEWAY_URL=http://localhost:8091/api
VITE_REALTIME_URL=http://localhost:8091
